[
    {
        "id": "talk_1",
        "condition": "nala_talk_count == 0",
        "content": [
            { "role": "Nala", "content": "好久不见了，小猫咪(*w*)，Luna~", "avatar": "Nala" },
            { "role": "Luna", "content": "好久不见，Nala，你还是那么有活力，哈哈", "avatar": "Luna" },
            { "role": "Nala", "content": "还好吧~", "avatar": "Nala" },
            { "role": "Nala", "content": "我的狗一直在叫，但是我这会忙不过来，你能帮我安抚一下他吗？", "avatar": "Nala" },
            { "role": "Luna", "content": "啊？", "avatar": "Luna" },
            { "role": "Nala", "content": "摸摸他就行，摸摸说哟西，真是个好孩子呐", "avatar": "Nala" },
            { "role": "Nala", "content": "别看他叫的这么凶，其实他就是想引起别人的注意", "avatar": "Nala" },
            { "role": "Luna", "content": "可是", "avatar": "Luna" },
            { "role": "Luna", "content": "我是猫女郎啊", "avatar": "Luna" },
            { "role": "Nala", "content": "安心啦，不会咬你哒，去吧去吧~", "avatar": "Nala" }
        ],
        "afterAction": "set_flag:nala_talk_count:1"
    },
    
    {
        "id": "talk_2",
        "condition": "nala_talk_count == 1",
        "content": [
            { "role": "Nala", "content": "拜托了，快去帮我安抚那只狗吧~", "avatar": "Nala" }
        ],
        "afterAction": "set_flag:nala_talk_count:2"
    },

    {
        "id": "talk_3_quest",
        "condition": "nala_talk_count == 2",
        "content": [
            { "role": "Nala", "content": "感谢你呐，Luna，你还是那么可靠！", "avatar": "Nala" },
            { "role": "Nala", "content": "我想请你帮个忙好吗", "avatar": "Nala" },
            { "role": "Nala", "content": "说起来这事怪我。。。", "avatar": "Nala" },
            { "role": "Nala", "content": "今天我睡过头了，出门比较匆忙", "avatar": "Nala" },
            { "role": "Nala", "content": "然后装蜡烛的袋子口子没封好！o(T~T)o", "avatar": "Nala" },
            { "role": "Nala", "content": "结果就。。。蜡烛基本丢完了", "avatar": "Nala" },
            { "role": "Luna", "content": "你还是老样子，哈哈", "avatar": "Luna" },
            { "role": "Nala", "content": "所有喽，你帮帮忙，帮我把蜡烛找回来", "avatar": "Nala" },
            { "role": "Nala", "content": "如果你能帮我找回全部的5根蜡烛，我就送你一把神器", "avatar": "Nala" },
            { "role": "Luna", "content": "神器？", "avatar": "Luna" },
            { "role": "Nala", "content": "是的，我觉得很适合你，加油呐~", "avatar": "Nala" }
        ],
        "afterAction": "accept_quest:1001" 
    },

    {
        "id": "check_delivery",
        "condition": "quest_1001_state == 1 && count_Candle >= 5",
        "content": [
            { "role": "Luna", "content": "Nala，我把 5 根蜡烛都找回来了！", "avatar": "Luna" },
            { "role": "Nala", "content": "哇！不愧是 Luna，动作真快。(≧▽≦)", "avatar": "Nala" },
            { "role": "Nala", "content": "把它们给我吧，我会履行诺言的。", "avatar": "Nala" },
            { "role": "Nala", "content": "这是给你的奖励——【战神之锤】！", "avatar": "Nala" }
        ],
        "afterAction": "check_quest_finish:1001:Candle:5"
    },

    {
        "id": "talk_waiting",
